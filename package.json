{
  "name": "geo-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:functions && concurrently \"cd functions && npm run build:watch\" \"firebase emulators:start\" \"astro dev\"",
    "build": "astro build",
    "build:functions": "cd functions && npm run build",
    "preview": "astro preview",
    "deploy": "npm run build && npm run build:functions && firebase deploy"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^5.1.0",
    "astro": "5.15.9",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
