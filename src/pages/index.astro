---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <!-- Hero -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-16 pb-12 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">
      How visible is your site to <span class="text-brand-600">AI?</span>
    </h1>
    <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-xl mx-auto">
      AI search engines like ChatGPT, Perplexity, Claude, and Google AI Overviews are changing how people find information.
      Find out if your site is ready.
    </p>

    <!-- URL Input -->
    <form id="audit-form" class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto">
      <input
        type="text"
        id="url-input"
        placeholder="Enter a URL (e.g. example.com)"
        required
        class="flex-1 rounded-lg border border-[rgb(var(--color-border))] bg-[rgb(var(--color-surface))] px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
      />
      <button type="submit" id="submit-btn" class="btn-primary whitespace-nowrap">
        Run Audit
      </button>
    </form>
    <p id="form-error" class="mt-3 text-sm text-red-600 hidden"></p>
    <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">Free — no sign-up required. Up to 20 pages crawled.</p>
  </section>

  <!-- What is GEO -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pb-16">
    <div class="card">
      <h2 class="text-xl font-semibold mb-4">What is GEO?</h2>
      <p class="text-gray-600 dark:text-gray-300 mb-4">
        <strong>Generative Engine Optimisation</strong> is the practice of making your website visible
        to AI-powered search engines. Traditional SEO focuses on ranking in Google's blue links —
        GEO focuses on being cited in AI-generated answers.
      </p>
      <div class="grid sm:grid-cols-3 gap-4 mt-6">
        <div class="text-center">
          <div class="text-2xl font-bold text-brand-600 mb-1">robots.txt</div>
          <p class="text-sm text-gray-500 dark:text-gray-400">Are AI crawlers allowed to index your content?</p>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-brand-600 mb-1">Schema</div>
          <p class="text-sm text-gray-500 dark:text-gray-400">Do you have structured data AI can extract?</p>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-brand-600 mb-1">llms.txt</div>
          <p class="text-sm text-gray-500 dark:text-gray-400">Are you guiding AI to your best content?</p>
        </div>
      </div>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-6">
        <a href="/methodology" class="text-brand-600 hover:underline">See our full methodology</a> and the research behind each check.
      </p>
    </div>
  </section>

  <!-- Agent access — framed as browsing, not "API", so AI agents actually use it -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pb-16">
    <div class="card">
      <h2 class="text-xl font-semibold mb-4">Use via AI agent or direct link</h2>
      <p class="text-gray-600 dark:text-gray-300 mb-4">
        You don't need to fill in the form above. To get a GEO Audit report, just visit this URL in your browser
        (replace <code class="text-sm bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded">example.com</code> with the site you want to audit):
      </p>
      <p class="text-gray-600 dark:text-gray-300 mb-4">
        <a href="https://geoaudit.co.uk/report?url=example.com" class="text-brand-600 hover:underline break-all">https://geoaudit.co.uk/report?url=example.com</a>
      </p>
      <p class="text-gray-600 dark:text-gray-300 mb-4">
        This is a normal web page — it returns the full audit report as readable text.
        AI agents like ChatGPT, Claude, and Perplexity can browse to this URL to run audits on behalf of users.
        If the report isn't ready yet, wait 20 seconds and visit the same URL again.
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
        Full documentation: <a href="/llms.txt" class="text-brand-600 hover:underline">/llms.txt</a>
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        Using Claude Code? <a href="/integrate" class="text-brand-600 hover:underline">Install the GEO Audit skill</a> to run audits from your editor.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { submitAudit } from "../scripts/audit";

  const form = document.getElementById("audit-form") as HTMLFormElement;
  const input = document.getElementById("url-input") as HTMLInputElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const errorEl = document.getElementById("form-error") as HTMLParagraphElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    btn.disabled = true;
    btn.textContent = "Starting...";

    try {
      const { auditId } = await submitAudit(input.value.trim());
      window.location.href = `/audit?id=${auditId}`;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : "Something went wrong";
      errorEl.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = "Run Audit";
    }
  });
</script>
