---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Audit Results — GEO Audit" noindex={true}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-8">
    <!-- Loading state -->
    <div id="loading-state">
      <div class="text-center py-16">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-50 dark:bg-brand-950 mb-4">
          <svg class="w-8 h-8 text-brand-600 animate-spin" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="31.4" stroke-linecap="round"/>
          </svg>
        </div>
        <h1 class="text-2xl font-bold mb-2" id="loading-title">Starting audit...</h1>
        <p class="text-gray-500 dark:text-gray-400" id="loading-subtitle">This usually takes 15-30 seconds</p>
        <div class="mt-4 max-w-xs mx-auto">
          <div class="bg-gray-200 dark:bg-gray-700 rounded-full h-2 overflow-hidden">
            <div id="progress-bar" class="bg-brand-600 h-2 rounded-full transition-all duration-500" style="width: 5%"></div>
          </div>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-2" id="progress-text"></p>
        </div>
      </div>
    </div>

    <!-- Error state -->
    <div id="error-state" class="hidden">
      <div class="text-center py-16">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-50 dark:bg-red-950 mb-4">
          <svg class="w-8 h-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/>
          </svg>
        </div>
        <h1 class="text-2xl font-bold mb-2">Audit failed</h1>
        <p class="text-gray-500 dark:text-gray-400" id="error-message"></p>
        <a href="/" class="btn-primary mt-6 inline-block">Try another URL</a>
      </div>
    </div>

    <!-- Results state -->
    <div id="results-state" class="hidden">
      <!-- Score header -->
      <div class="flex flex-col sm:flex-row items-center gap-6 mb-8">
        <div class="relative">
          <svg id="score-gauge" width="140" height="140" viewBox="0 0 140 140" class="transform -rotate-90">
            <circle cx="70" cy="70" r="60" fill="none" stroke="rgb(var(--color-border))" stroke-width="10"/>
            <circle id="score-ring" cx="70" cy="70" r="60" fill="none" stroke-width="10" stroke-linecap="round"
              stroke-dasharray="377" stroke-dashoffset="377" class="transition-all duration-1000"/>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span id="score-number" class="text-3xl font-bold">0</span>
            <span class="text-xs text-gray-500 dark:text-gray-400">/100</span>
          </div>
        </div>
        <div>
          <h1 class="text-2xl font-bold" id="result-url"></h1>
          <div class="flex items-center gap-2 mt-1">
            <span id="grade-badge" class="inline-block px-3 py-1 rounded-full text-sm font-semibold"></span>
            <span class="text-sm text-gray-500 dark:text-gray-400" id="pages-crawled"></span>
          </div>
        </div>
      </div>

      <!-- Category breakdown -->
      <div id="categories-container" class="space-y-4 mb-8"></div>

      <!-- Recommendations -->
      <div id="recommendations-container" class="mb-8">
        <h2 class="text-xl font-semibold mb-4">Recommendations</h2>
        <div id="recs-list" class="space-y-3"></div>
      </div>

      <!-- Save report -->
      <div class="card text-center">
        <p class="text-gray-600 dark:text-gray-300 mb-3">This report expires in 24 hours. Download a copy to keep it.</p>
        <button id="download-btn" class="btn-primary hidden">
          <svg class="w-4 h-4 inline-block mr-1.5 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3"/>
          </svg>
          Download report
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { pollAuditStatus, type AuditStatusResponse } from "../scripts/audit";

  const params = new URLSearchParams(window.location.search);
  const auditId = params.get("id");

  if (!auditId) {
    window.location.href = "/";
  } else {
    const loadingState = document.getElementById("loading-state")!;
    const errorState = document.getElementById("error-state")!;
    const resultsState = document.getElementById("results-state")!;
    const loadingTitle = document.getElementById("loading-title")!;
    const loadingSubtitle = document.getElementById("loading-subtitle")!;
    const progressBar = document.getElementById("progress-bar")!;
    const progressText = document.getElementById("progress-text")!;
    const errorMessage = document.getElementById("error-message")!;

    pollAuditStatus(auditId, (data: AuditStatusResponse) => {
      if (data.status === "queued") {
        loadingTitle.textContent = "Queued...";
        loadingSubtitle.textContent = "Your audit will start shortly";
        progressBar.style.width = "5%";
      }

      if (data.status === "running" && data.progress) {
        loadingTitle.textContent = data.progress.phase;
        if (data.progress.pagesCrawled != null && data.progress.maxPages) {
          const pct = Math.min(90, (data.progress.pagesCrawled / data.progress.maxPages) * 80 + 10);
          progressBar.style.width = `${pct}%`;
          progressText.textContent = `${data.progress.pagesCrawled} / ${data.progress.maxPages} pages`;
        } else {
          progressBar.style.width = "15%";
          progressText.textContent = "";
        }
        loadingSubtitle.textContent = data.url;
      }

      if (data.status === "failed") {
        loadingState.classList.add("hidden");
        errorState.classList.remove("hidden");
        errorMessage.textContent = data.error || "An unknown error occurred";
      }

      if (data.status === "completed" && data.result) {
        loadingState.classList.add("hidden");
        resultsState.classList.remove("hidden");
        renderResults(data);

        // Wire download button
        const downloadBtn = document.getElementById("download-btn")!;
        downloadBtn.classList.remove("hidden");
        downloadBtn.addEventListener("click", () => downloadMarkdown(data));
      }
    });
  }

  function renderResults(data: AuditStatusResponse) {
    const result = data.result as any;
    const recommendations = data.recommendations as any;

    // Score gauge
    const score = result.score.score;
    const ring = document.getElementById("score-ring")!;
    const circumference = 2 * Math.PI * 60; // r=60
    const offset = circumference - (score / 100) * circumference;
    ring.style.strokeDashoffset = String(offset);
    ring.style.stroke = scoreColor(score);
    document.getElementById("score-number")!.textContent = String(score);

    // Grade badge
    const badge = document.getElementById("grade-badge")!;
    badge.textContent = result.score.grade;
    badge.className = `inline-block px-3 py-1 rounded-full text-sm font-semibold ${gradeClass(result.score.grade)}`;

    // URL and pages
    document.getElementById("result-url")!.textContent = result.url;
    document.getElementById("pages-crawled")!.textContent = `${result.pagesCrawled} pages crawled`;

    // Categories
    const container = document.getElementById("categories-container")!;
    container.innerHTML = "";
    for (const cat of result.score.categories) {
      const pct = cat.maxScore > 0 ? Math.round((cat.score / cat.maxScore) * 100) : 0;
      const section = document.createElement("div");
      section.className = "card";
      section.innerHTML = `
        <button class="w-full text-left flex items-center justify-between" data-toggle>
          <div class="flex items-center gap-3">
            <span class="text-sm font-semibold capitalize">${cat.category}</span>
            <span class="text-xs text-gray-500 dark:text-gray-400">${pct}%</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform" data-chevron viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/>
          </svg>
        </button>
        <div class="mt-3 hidden" data-content>
          ${cat.checks.map((check: any) => `
            <div class="flex items-center justify-between py-2 border-t border-[rgb(var(--color-border))]">
              <div>
                <p class="text-sm font-medium">${check.name}</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">${check.rationale}</p>
              </div>
              <span class="text-sm font-semibold ml-4 whitespace-nowrap ${check.score >= 7 ? "text-green-600" : check.score >= 4 ? "text-yellow-600" : "text-red-600"}">${check.score}/10</span>
            </div>
          `).join("")}
        </div>
      `;
      section.querySelector("[data-toggle]")!.addEventListener("click", () => {
        const content = section.querySelector("[data-content]") as HTMLElement;
        const chevron = section.querySelector("[data-chevron]") as HTMLElement;
        content.classList.toggle("hidden");
        chevron.classList.toggle("rotate-180");
      });
      container.appendChild(section);
    }

    // Recommendations
    const recsList = document.getElementById("recs-list")!;
    recsList.innerHTML = "";
    if (recommendations && recommendations.recommendations) {
      for (const rec of recommendations.recommendations) {
        const el = document.createElement("div");
        el.className = "card";
        el.innerHTML = `
          <button class="w-full text-left" data-toggle>
            <div class="flex items-center gap-2 mb-1">
              <span class="inline-block w-2 h-2 rounded-full ${impactDot(rec.impact.level)}"></span>
              <span class="text-sm font-semibold">${rec.title}</span>
              <span class="ml-auto text-xs px-2 py-0.5 rounded-full ${disruptionBadge(rec.disruption)}">${rec.disruption}</span>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400">${rec.description}</p>
          </button>
          <div class="mt-3 hidden" data-content>
            <p class="text-xs text-gray-500 dark:text-gray-400 italic mb-2">${rec.impact.citation}</p>
            <ol class="text-sm space-y-1 list-decimal list-inside">
              ${rec.steps.map((s: string) => `<li>${s}</li>`).join("")}
            </ol>
            ${rec.affectedPages.length > 0 ? `
              <details class="mt-2">
                <summary class="text-xs text-gray-500 dark:text-gray-400 cursor-pointer">Affected pages (${rec.affectedPages.length})</summary>
                <ul class="text-xs mt-1 space-y-0.5">${rec.affectedPages.map((p: string) => `<li class="truncate">${p}</li>`).join("")}</ul>
              </details>
            ` : ""}
          </div>
        `;
        el.querySelector("[data-toggle]")!.addEventListener("click", () => {
          const content = el.querySelector("[data-content]") as HTMLElement;
          content.classList.toggle("hidden");
        });
        recsList.appendChild(el);
      }
    }
  }

  function generateMarkdown(data: AuditStatusResponse): string {
    const result = data.result as any;
    const recommendations = data.recommendations as any;
    const score = result.score;
    const domain = new URL(result.url).hostname;

    let md = `# GEO Audit Report — ${domain}\n\n`;
    md += `**URL:** ${result.url}  |  **Score:** ${score.score}/100 (${score.grade})  |  **Pages crawled:** ${result.pagesCrawled}\n\n`;

    md += `## Score Breakdown\n\n`;
    for (const cat of score.categories) {
      const pct = cat.maxScore > 0 ? Math.round((cat.score / cat.maxScore) * 100) : 0;
      md += `### ${cat.category.charAt(0).toUpperCase() + cat.category.slice(1)} — ${pct}%\n\n`;
      md += `| Check | Score | Rationale |\n`;
      md += `|-------|-------|-----------|\n`;
      for (const check of cat.checks) {
        const rationale = check.rationale.replace(/\|/g, "\\|");
        md += `| ${check.name} | ${check.score}/10 | ${rationale} |\n`;
      }
      md += `\n`;
    }

    if (recommendations?.recommendations?.length) {
      md += `## Recommendations\n\n`;
      for (const rec of recommendations.recommendations) {
        md += `### ${rec.title} [${rec.disruption}] [${rec.impact.level}]\n\n`;
        md += `${rec.description}\n\n`;
        if (rec.impact.citation) {
          md += `> ${rec.impact.citation}\n\n`;
        }
        for (let i = 0; i < rec.steps.length; i++) {
          md += `${i + 1}. ${rec.steps[i]}\n`;
        }
        if (rec.affectedPages.length > 0) {
          md += `\n**Affected pages:** ${rec.affectedPages.join(", ")}\n`;
        }
        md += `\n`;
      }
    }

    return md;
  }

  function downloadMarkdown(data: AuditStatusResponse) {
    const result = data.result as any;
    const domain = new URL(result.url).hostname;
    const md = generateMarkdown(data);
    const blob = new Blob([md], { type: "text/markdown" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `geo-report-${domain}.md`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function scoreColor(score: number): string {
    if (score >= 80) return "#16b362";
    if (score >= 60) return "#eab308";
    if (score >= 40) return "#f97316";
    return "#ef4444";
  }

  function gradeClass(grade: string): string {
    switch (grade) {
      case "Excellent": return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200";
      case "Good": return "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200";
      case "Needs Work": return "bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200";
      default: return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200";
    }
  }

  function impactDot(level: string): string {
    switch (level) {
      case "high": return "bg-red-500";
      case "medium": return "bg-yellow-500";
      default: return "bg-gray-400";
    }
  }

  function disruptionBadge(level: string): string {
    switch (level) {
      case "non-invasive": return "bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300";
      case "low": return "bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300";
      case "moderate": return "bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300";
      default: return "bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300";
    }
  }
</script>
